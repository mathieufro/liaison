  "routines": {
    "failed-payments": {
      "description": "Every morning, draft a payment reminder for each failed card payment that needs one.",
      "kind": "recurring",
      "cron": "0 7 * * *",
      "timezone": "UTC",
      "promptTemplate": "For each failed Stripe payment that Stripe no longer retries and that has no reminder waiting, draft one with mail__compose, followUp {refs:[{kind:\"stripe:invoice\", id}], classification:\"service\"}. Get the link with card_update_link and say what it does using its effect. Mention the customer's open tickets. Skip payments Stripe still retries.",
      "scopes": [
        "stripe:customers:read",
        "stripe:invoices:read",
        "stripe:payments:read",
        "mail:conversations:write",
        "tickets:tickets:read"
      ],
      "enabledByDefault": false,
      "followUp": true
    }
  },
