# Dependencies
node_modules

# Runtime app-install root in dev (LIAISON_APPS_DIR default set by scripts/dev.ts)
/.liaison-apps/

# Per-suite app-install roots. An integration test that runs without
# LIAISON_APPS_DIR set falls back to its own `.liaison-apps-<suite>/` in the
# repo root and unpacks every bundled app into it, which is megabytes of
# regenerable output. The glob rather than one literal: the fallback is named
# after the suite, so the next suite to need one arrives already ignored
# instead of sitting in `git status` until somebody notices.
/.liaison-apps-*/

# Build output
dist/
dist-native/
dist-worker/
dist-e2e/
.output/

# Bun
# The ROOT bun.lock is COMMITTED on purpose -- see ops/deploy/README.md. It was
# ignored by the initial scaffolding commit, which combined with the
# Dockerfile's `bun install --frozen-lockfile` meant every node carried its own
# copy and any new dependency failed the prod build until someone relocked each
# box by hand.
#
# Nested lockfiles stay ignored: this is a bun workspace, so a bun.lock inside a
# workspace member is a stray from running an install in the wrong directory,
# never something to version.
bun.lock
!/bun.lock

# Provisioning input for a self-hosted instance (config + gathered knowledge),
# mounted read only into the app container at /setup. Holds company data.
/deploy/setup/
# The setup playbook's API keys and tokens. Kept OUT of deploy/setup/, which
# the long-running app container mounts.
/deploy/.setup-secrets.env

# Chaos simulator run output (transcripts, per-run worlds). Regenerable, and
# scenario-flavoured, so it must never be swept into a bulk `git add`.
.chaos/
**/.chaos/

# Environment
.env
.env.*
!.env.example
!.env.test.example

