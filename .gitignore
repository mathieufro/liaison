.strobe/

.playwright-mcp/

logs/

# Phase 14 validation artifacts (regenerated on every run)
/.liaison-release.json
/data/
/deploy/data/
# deploy/rolling-deploy.sh state: its lock, the draining list, the drain log.
/deploy/.rolling/
# deploy/backup.sh archives: they hold the data keys.
/deploy/backups/
/backups/
/qa/load/out/
BLOCKED.md

# First-party app catalog (frozen .liaisonapp tarballs + catalog.json), built by
# scripts/build-app-catalog.ts. Baked into the image at build time; never committed.
/app-catalog/

# Ad-hoc local validation scratch (screenshots, throwaway scripts, session state)
/gestalt-validation-tmp/

# Linux visual baselines: no pinned Linux render environment exists, so they are not tracked.
# Regenerate locally with a Linux run; darwin baselines are the reference.
*-linux.png

# Test-only validator caches (compiled schematron SEFs, Rust build output)
/tools/schematron/.sef/
/tools/pdfa-check/target/

# Agent worktrees (the repo convention puts them under .claude/worktrees/)
.claude/worktrees/
