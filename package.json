{
  "name": "liaison",
  "private": true,
  "license": "FSL-1.1-ALv2",
  "workspaces": [
    "apps/*",
    "apps/desktop/sidecar",
    "packages/*"
  ],
  "scripts": {
    "pr:land": "bun run scripts/pr-land.ts",
    "slots": "bun run scripts/slots.ts",
    "prepare": "git config core.hooksPath scripts/git-hooks || true",
    "bootstrap:test-env": "bun run scripts/bootstrap-test-env.ts",
    "pretest": "bun run bootstrap:test-env",
    "pretest:integration": "bun run bootstrap:test-env",
    "pretest:e2e": "bun run bootstrap:test-env",
    "pretest:e2e:parallel": "bun run bootstrap:test-env",
    "i18n:gen": "bun run scripts/i18n-gen-dictionaries.ts",
    "i18n:gen:check": "bun run scripts/i18n-gen-dictionaries.ts --check",
    "predev": "bun run scripts/i18n-gen-dictionaries.ts",
    "dev": "bun run scripts/dev.ts",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "lint": "biome check . && bun run scripts/lint-db-connection-import.ts && bun run scripts/lint-button-width.ts",
    "lint:i18n": "bun run scripts/lint-i18n-strings.ts",
    "knip": "bunx knip@6.35.1",
    "lint:copy": "bun run scripts/lint-copy-dashes.ts",
    "check:db-connection-import": "bun run scripts/lint-db-connection-import.ts",
    "docs:build": "bun run scripts/docs/build.ts",
    "docs:gen": "bun run scripts/docs/gen-reference.ts",
    "manifest-regex:prove": "bun run scripts/gen-manifest-regex-proven.ts",
    "check:button-width": "bun run scripts/lint-button-width.ts",
    "i18n:fr": "bun run scripts/i18n-gen-fr.ts",
    "i18n:fr:check": "bun run scripts/i18n-gen-fr.ts --check",
    "typecheck": "bun run scripts/with-test-lock.ts --slot-only -- bun run typecheck:in-slot",
    "typecheck:in-slot": "bun --filter '*' typecheck && bun run typecheck:scripts",
    "typecheck:scripts": "bun run scripts/with-test-lock.ts --slot-only -- tsc --noEmit -p scripts/tsconfig.json",
    "typecheck:fast": "bun run scripts/with-test-lock.ts --slot-only -- bun run scripts/ci-scope.ts typecheck --all --tool tsgo",
    "typecheck:changed": "bun run scripts/with-test-lock.ts --slot-only -- bun run scripts/ci-scope.ts typecheck --tool tsgo",
    "typecheck:apps": "bun run scripts/with-test-lock.ts --slot-only -- bun run scripts/ci-scope.ts typecheck-apps",
    "test": "bun run scripts/with-test-lock.ts --slot-only -- bun run test:in-slot",
    "test:in-slot": "bun --filter '@liaison/api' test && bun --filter '@liaison/web' test && bun run test:root",
    "test:web": "bun run scripts/with-test-lock.ts --slot-only -- bun --filter '@liaison/web' test",
    "test:web-unit": "bun run scripts/test-run.ts web-unit",
    "test:unit": "bun run scripts/test-run.ts unit && bun run test:guards && bun run test:root",
    "test:integration": "bun run scripts/test-run.ts integration",
    "test:mailbox-crypto": "bun run scripts/test-run.ts mailbox-crypto",
    "test:e2e": "bun run scripts/test-run.ts e2e",
    "test:playwright": "bun run scripts/test-run.ts playwright",
    "test:e2e:web": "bun run scripts/test-run.ts playwright",
    "test:e2e:parallel": "bun run scripts/test-run.ts e2e-parallel",
    "test:guards": "bun run scripts/test-run.ts guards",
    "tool-bench": "bun apps/api/src/modules/agent/tools/tool-bench/run.ts",
    "test:root": "bun run scripts/test-run.ts root",
    "test:full": "bun run scripts/test-run.ts full",
    "test:gate": "bun run scripts/test-gate.ts",
    "test:worker-env": "bun run scripts/test-run.ts worker-env",
    "seed": "bun run scripts/seed-qa.ts",
    "demo:seed": "bun run apps/api/src/cli/index.ts seed --tier demo",
    "seed:qa": "bun run scripts/seed-qa.ts --yes",
    "db:generate": "bun --filter '@liaison/api' db:generate",
    "db:migrate": "bun --filter '@liaison/api' db:migrate",
    "db:reset": "bun run scripts/db-reset.ts dev",
    "db:reset:test": "bun run scripts/db-reset.ts test",
    "infra:up": "bun run scripts/infra-up.ts",
    "infra:check": "bun run scripts/infra-up.ts --check",
    "infra:down": "docker compose down",
    "load-test": "bun run scripts/load-test.ts",
    "lighthouse-ci": "bun run scripts/lighthouse-ci.ts",
    "validate-compose": "bun run scripts/validate-compose.ts",
    "check:migration-baseline": "bun run scripts/check-migration-baseline.ts",
    "check:migration-safety": "bun run scripts/check-migration-safety.ts",
    "check:raw-insert": "bun run scripts/check-raw-insert.ts",
    "check:bundled-app-version": "bun run scripts/check-bundled-app-version.ts",
    "check:runbook-sections": "bun run scripts/check-runbook-sections.ts",
    "check:docs": "bun run scripts/with-test-lock.ts --slot-only -- bun run scripts/check-docs.ts",
    "check:spdx": "bun run scripts/check-spdx.ts",
    "check:grants": "bun run scripts/db-readonly-role.ts --check-sync",
    "check:tour-anchors": "bun run scripts/tour-anchors-check.ts",
    "app:create": "bun run scripts/create-app.ts",
    "app:freeze": "bun run scripts/freeze-app.ts",
    "app:sign": "bun run scripts/sign-app.ts",
    "desktop:dev": "cd apps/desktop && bunx tauri dev",
    "desktop:build": "cd apps/desktop && bun run ../../scripts/with-test-lock.ts --slot-only -- bunx tauri build",
    "sidecar:build": "cd apps/desktop/sidecar && bun run build.ts",
    "check:desktop-no-node": "bun run scripts/check-desktop-no-node.ts",
    "test:desktop": "bun run scripts/test-run.ts desktop",
    "test:desktop:ui": "bun run scripts/test-run.ts desktop-ui",
    "test:mobile": "bun run scripts/test-run.ts mobile",
    "build:mobile": "cd apps/mobile && bun run ../../scripts/with-test-lock.ts --slot-only -- bun run build:mobile"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@liaison/app-sdk": "workspace:*",
    "@liaison/app-ui": "workspace:*",
    "@liaison/db-core": "workspace:*",
    "@liaison/host": "workspace:*",
    "@liaison/shared": "workspace:*",
    "@liaison/test-helpers": "workspace:*",
    "@types/bun": "latest",
    "@types/k6": "^2.3.0",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "esbuild": "^0.28.2",
    "esbuild-plugin-solid": "^0.6.0",
    "marked": "^18.0.14",
    "pdf-parse": "^1.1.4",
    "playwright": "^1.63.0",
    "postgres": "^3.4.9",
    "solid-js": "^1.9.17",
    "typescript": "^6.0.3",
    "xslt3": "2.7.0",
    "zod": "^4.6.7"
  },
  "overrides": {
    "ioredis": "6.0.0",
    "uuid": "^11.1.1"
  }
}
