{
  "name": "example",
  "version": "0.0.7",
  "description": "Reference app demonstrating every Liaison SDK surface",
  "listing": {
    "publisher": "Liaison",
    "category": "Developer",
    "icon": "code",
    "summary": "Reference app showing every surface of the Liaison app SDK.",
    "sourceRepository": "https://github.com/liaison-sh/liaison/tree/main/apps/api/test-support/apps/example"
  },
  "packageFormat": 1,
  "license": "MIT",
  "host": "^1",
  "scopes": ["example:items:read", "example:items:write", "example:external:read"],
  "schema": {
    "items": {
      "fields": {
        "text": "string",
        "createdBy": { "type": "uuid", "required": false }
      },
      "searchable": ["text"]
    },
    "summaries": {
      "rlsScope": "items",
      "fields": {
        "itemCount": { "type": "number" },
        "computedAt": "date"
      }
    }
  },
  "features": {
    "item_notes": {
      "adminScope": "example:items:write",
      "labelKey": "apps.example.features.itemNotes"
    },
    "slot_panels": {
      "adminScope": "example:items:write",
      "labelKey": "apps.example.features.slotPanels"
    }
  },
  "entities": {
    "items": {
      "labelField": "text",
      "searchable": true,
      "tableName": "items",
      "readScope": "example:items:read",
      "discussion": true
    }
  },
  "views": {
    "tabTypes": {
      "items": {
        "label": "Example item",
        "icon": "Square",
        "urlPattern": "/example/items/:entityId"
      }
    }
  },
  "slots": {
    "project:task:tabs": {
      "panels": [
        {
          "id": "example-project-task-tabs",
          "label": "Example",
          "component": "ExampleTaskTab",
          "visibility_scope": "example:items:read",
          "feature": "slot_panels"
        }
      ]
    },
    "project:task:actions": {
      "actions": [
        {
          "id": "example-project-task-actions",
          "label": "Example action",
          "component": "ExampleTaskAction",
          "visibility_scope": "example:items:read",
          "feature": "slot_panels"
        }
      ]
    },
    "project:detail:panel": {
      "panels": [
        {
          "id": "example-project-detail-panel",
          "label": "Example",
          "component": "ExampleProjectPanel",
          "visibility_scope": "example:items:read",
          "feature": "slot_panels"
        }
      ]
    },
    "contact_detail": {
      "panels": [
        {
          "id": "example-contact-detail",
          "label": "Example",
          "component": "ExampleContactPanel",
          "visibility_scope": "example:items:read",
          "feature": "slot_panels"
        }
      ]
    },
    "ticket:detail:panel": {
      "panels": [
        {
          "id": "example-ticket-detail-panel",
          "label": "Example",
          "component": "ExampleTicketPanel",
          "visibility_scope": "example:items:read",
          "feature": "slot_panels"
        }
      ]
    },
    "ticket:detail:actions": {
      "actions": [
        {
          "id": "example-ticket-detail-actions",
          "label": "Example action",
          "component": "ExampleTicketAction",
          "visibility_scope": "example:items:read",
          "feature": "slot_panels"
        }
      ]
    }
  },
  "contextProviders": [
    {
      "on": ["example:items"],
      "tool": "item_context",
      "scope": "example:items:read",
      "loadTools": ["items_list"]
    }
  ],
  "tools": {
    "item_context": {
      "description": "Facts about one example item, for the agent's context while it is in view",
      "requiredScopes": ["example:items:read"],
      "handler": "item_context",
      "readOnly": true,
      "agentVisible": false,
      "params": {
        "type": "object",
        "properties": {
          "subject": {
            "type": "object",
            "properties": {
              "app": { "type": "string" },
              "entityType": { "type": "string" },
              "entityId": { "type": "string" }
            },
            "required": ["app", "entityType", "entityId"]
          }
        },
        "required": ["subject"]
      }
    },
    "item_notes_count": {
      "description": "Count example items for the notes feature",
      "requiredScopes": ["example:items:read"],
      "handler": "item_notes_count",
      "readOnly": true,
      "feature": "item_notes",
      "params": { "type": "object", "properties": {} }
    },
    "items_list": {
      "description": "List example items",
      "requiredScopes": ["example:items:read"],
      "handler": "items_list",
      "readOnly": true,
      "params": { "type": "object", "properties": {} }
    },
    "items_count_on_turn": {
      "description": "Count example items, only on a person's own turn",
      "requiredScopes": ["example:items:read"],
      "handler": "items_count_on_turn",
      "readOnly": true,
      "humanTurnOnly": true,
      "params": { "type": "object", "properties": {} }
    },
    "items_count_in_dm": {
      "description": "Count example items, only in a DM with the agent",
      "requiredScopes": ["example:items:read"],
      "handler": "items_count_in_dm",
      "readOnly": true,
      "dmOnly": true,
      "params": { "type": "object", "properties": {} }
    },
    "items_create": {
      "description": "Create an example item",
      "requiredScopes": ["example:items:write"],
      "handler": "items_create",
      "writesToTable": "app_example.items",
      "params": {
        "type": "object",
        "properties": { "text": { "type": "string", "minLength": 1 } },
        "required": ["text"]
      }
    },
    "external_fetch": {
      "description": "Demonstrate the connections + fetch surface",
      "requiredScopes": ["example:external:read"],
      "handler": "external_fetch",
      "readOnly": true,
      "params": { "type": "object", "properties": {} }
    },
    "resolve_contact": {
      "description": "Demonstrate the contacts integration surface",
      "requiredScopes": ["example:items:read"],
      "handler": "resolve_contact",
      "params": {
        "type": "object",
        "properties": { "email": { "type": "string" } },
        "required": ["email"]
      }
    }
  },
  "events": {
    "emits": ["item:created", "summary:computed"]
  },
  "jobs": {
    "nightly_summary": {
      "runsFor": {
        "everyOrg": "The example app summarizes each org's own data every night; it needs no connection."
      },
      "schedule": "0 0 * * *",
      "handler": "nightly_summary"
    }
  }
}
